{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accessmi.org/data/schema/michigan-county-income-poverty.schema.json",
  "title": "Michigan county income and poverty (Census SAIPE)",
  "type": "object",
  "required": [
    "provenance",
    "measures",
    "counties"
  ],
  "properties": {
    "provenance": {
      "type": "object",
      "required": [
        "source_name",
        "source_url",
        "download_url",
        "estimate_year",
        "ingested_at",
        "value_label",
        "populated"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "download_url": {
          "type": "string",
          "format": "uri"
        },
        "estimate_year": {
          "type": "integer"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "description": "Retrieval time. Not the reporting period."
        },
        "value_label": {
          "enum": [
            "VERIFIED",
            "MODELED",
            "PROJECTED",
            "PENDING",
            "REPORTED",
            "INSUFFICIENT_DATA"
          ]
        },
        "populated": {
          "type": "boolean"
        },
        "pending_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "unit",
          "value_label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "enum": [
              "percent",
              "dollars"
            ]
          },
          "value_label": {
            "enum": [
              "VERIFIED",
              "MODELED",
              "PROJECTED",
              "PENDING",
              "REPORTED",
              "INSUFFICIENT_DATA"
            ]
          }
        }
      }
    },
    "counties": {
      "type": "array",
      "minItems": 83,
      "maxItems": 83,
      "items": {
        "type": "object",
        "required": [
          "countyFips",
          "countyName",
          "status",
          "values",
          "confidence"
        ],
        "properties": {
          "countyFips": {
            "type": "string",
            "pattern": "^26[0-9]{3}$"
          },
          "countyName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            },
            "description": "null = unavailable or suppressed; never treat as zero"
          },
          "confidence": {
            "type": "object",
            "description": "90% lower/upper bounds. A measure absent here has no published uncertainty in this file.",
            "additionalProperties": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "pendingReason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
