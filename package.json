{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*|bun/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "cd artifacts/access-mi && PORT=${PORT:-8080} BASE_PATH=${BASE_PATH:-/} node_modules/.bin/vite --config vite.config.ts --host 0.0.0.0",
    "build": "cd artifacts/access-mi && node scripts/build-alice-county.mjs && node scripts/generate-provenance-index.mjs && node scripts/generate-source-catalog.mjs && node scripts/generate-sitemap.mjs && node scripts/check-postbuild-parity.mjs && node_modules/.bin/vite build --config vite.config.ts && node scripts/prerender-meta.mjs && node scripts/prerender-extra-meta.mjs && node scripts/generate-spa-rewrites.mjs && node scripts/normalize-project-schema.mjs && node scripts/check-extra-prerender.mjs && node scripts/check-county-prerender.mjs && node scripts/check-seo-prerender.mjs && node scripts/check-spa-rewrites.mjs && node scripts/check-precache-budget.mjs && rm -rf ../../dist && cp -r dist ../../dist",
    "build:dev": "cd artifacts/access-mi && node_modules/.bin/vite build --mode development --config vite.config.ts && rm -rf ../../dist && cp -r dist ../../dist",
    "typecheck:libs": "tsc --build",
    "typecheck": "tsc --build"
  },
  "private": true,
  "devDependencies": {
    "drizzle-kit": "0.x",
    "drizzle-orm": "0.x",
    "postgres": "^4.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "workspaces": {
    "packages": [
      "artifacts/*",
      "lib/*",
      "lib/integrations/*",
      "scripts"
    ],
    "catalog": {
